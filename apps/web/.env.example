NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_REPO_URL=https://github.com/vercel/shop
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Anthropic API keys.
APP_ENCRYPTION_KEY=
# Snapshot produced by `pnpm snapshot:build`
SANDBOX_SNAPSHOT_ID=
# Vercel Sandbox auth: automatic on Vercel via OIDC; locally run `vercel env pull`
VERCEL_OIDC_TOKEN=
# Gate account creation (invitees via email links don't need it). Leave empty to disable.
SIGNUP_INVITE_CODE=
